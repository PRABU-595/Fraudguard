# ==============================================================================
# FRAUDGUARD ENTERPRISE CONFIGURATION TEMPLATE
# Copy to .env and configure for your local or AWS production deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=8081
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false

# ------------------------------------------------------------------------------
# 2. PERSISTENCE & STORAGE BACKEND
# Options: 'local' (JSON files in data/) or 'dynamodb' (AWS DynamoDB)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=dynamodb
USE_AWS_DYNAMODB=true
AWS_REGION=eu-north-1
DYNAMODB_TABLE=fraud-transactions
QUARANTINE_TABLE=fraud-quarantine
AUDIT_LOG_TABLE=fraud-analyst-audit

# ------------------------------------------------------------------------------
# 3. TELEMETRY & ENRICHMENT PROVIDERS
# Cell Location Provider: 'simulated' | 'opencellid' | 'camara'
# ------------------------------------------------------------------------------
CELL_LOCATION_PROVIDER=simulated
OPENCELLID_API_KEY=
CAMARA_API_ENDPOINT=
CAMARA_CLIENT_ID=
CAMARA_CLIENT_SECRET=

# Identity & Phone Carrier Intelligence
IDENTITY_RISK_PROVIDER=simulated
IDENTITY_VENDOR_API_KEY=

# Social Reputation Intelligence (Consented - Zero Scraping)
SOCIAL_RISK_PROVIDER=simulated
SOCIAL_VENDOR_API_KEY=

# MaxMind GeoLite2 Offline Database
MAXMIND_LICENSE_KEY=
MAXMIND_DB_PATH=/app/data/GeoLite2-City.mmdb

# Tor Bulk Exit Node Downloader (Refreshed hourly)
TOR_EXIT_LIST_URL=https://check.torproject.org/torbulkexitlist
TOR_REFRESH_INTERVAL_HOURS=1

# ------------------------------------------------------------------------------
# 4. ANALYST AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret API key required for analyst actions (RELEASE, CONFIRM_FRAUD, ESCALATE)
QUARANTINE_RELEASE_API_KEY=prod-analyst-secret-change-me-39482
ADMIN_SECRET_KEY=prod-admin-secret-change-me-91823

# ------------------------------------------------------------------------------
# 5. DEMO SIMULATOR CONTROLS
# In production, set to 'false' so only real stream events are ingested.
# ------------------------------------------------------------------------------
ENABLE_DEMO_SIMULATOR=false
DEFAULT_SIMULATION_TPS=1.0

# ------------------------------------------------------------------------------
# 6. THREAT MAP TILE CONFIGURATION
# Options for local dev: standard OpenStreetMap with dark CSS filter
# ------------------------------------------------------------------------------
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
MAP_API_KEY=
